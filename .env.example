# Flux — AI Agent Runtime
# Copy this file to .env and fill in your API keys

# =====================================================
# LLM Provider (BYOK — bring your own key)
# =====================================================
ANTHROPIC_API_KEY=your-anthropic-key-here
# OPENAI_API_KEY=your-openai-key-here
# GOOGLE_API_KEY=your-google-key-here

# Default LLM settings
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5-20251001

# Logging
# LOG_LEVEL=INFO
# LOG_FORMAT=text

# =====================================================
# Web API (Week 3+)
# =====================================================

# SQLAlchemy URL — Postgres in production, SQLite for quick local dev/tests
FLUX_DATABASE_URL=postgresql+asyncpg://flux:flux_dev@localhost:5432/flux
# FLUX_DATABASE_URL=sqlite+aiosqlite:///./flux-dev.db

# JWT signing key. MUST be a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
# JWT_ACCESS_TTL=3600     # seconds

# Cookie behaviour
# FLUX_COOKIE_NAME=flux_access
# FLUX_COOKIE_SECURE=false   # set "true" behind HTTPS
# FLUX_COOKIE_DOMAIN=        # leave empty for same-origin dev

# GitHub OAuth App credentials
# Register at https://github.com/settings/developers — "New OAuth App"
# Authorization callback URL: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_CALLBACK_URL=http://localhost:3000/auth/github/callback
FRONTEND_URL=http://localhost:3000

# =====================================================
# Frontend (web/) — put these in web/.env.local
# =====================================================
# FLUX_API_ORIGIN=http://localhost:8000
